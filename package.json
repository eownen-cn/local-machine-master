    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.5.3",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
